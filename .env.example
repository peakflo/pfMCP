ENVIRONMENT=local
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

NANGO_SECRET_KEY=....
NANGO_HOST=https://api.nango.dev

STORAGE_PROVIDER=local  # "local" for development, "gcs" for production
LOCAL_STORAGE_DIR=/tmp/pfmcp-attachments  # local provider only
GCS_BUCKET_NAME=your-bucket-name  # gcs provider only

# Customer Files tab. This is the Peakflo storage bucket, not GCS_BUCKET_NAME.
# Stage: peakflo.appspot.com and https://stage-billing-api.peakflo.co/v1
PEAKFLO_STORAGE_BUCKET=peakflo.appspot.com
PEAKFLO_BILLING_API_BASE_URL=https://stage-billing-api.peakflo.co/v1
# RS256 PEM used to sign POST /files. Same key as the billing generateToken key.
# One line with \n escapes is accepted. Do not put the Peakflo API key here.
PEAKFLO_BILLING_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Delivery tracking (optional — watch/webhook only set up when defined)
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail-notifications
OUTLOOK_WEBHOOK_URL=https://your-domain.com/api/outlook/webhook

# Peakflo internal credential broker for direct system-of-record tools.
# Store the real secret in Secret Manager for deployed environments.
PEAKFLO_INTERNAL_API_BASE_URL=https://api.peakflo.ai
PF_MCP_CREDENTIAL_BROKER_SECRET=...
